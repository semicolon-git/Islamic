# Copy to .env.local and fill in what you need. Everything is optional for a local demo.

# Database: leave empty to use the embedded Postgres (PGlite) in DATA_DIR.
# For a hosted deployment use any Postgres 15+ with the pg_trgm extension (e.g. Supabase, Neon).
DATABASE_URL=
DATA_DIR=.data/pglite
UPLOAD_DIR=.data/uploads

# Required in production: a long random string used to sign portal sessions.
SESSION_SECRET=

# Demo personas (portal sign-in). DEMO_MODE=true marks seeded people, institutions and approvals "(demo)".
DEMO_MODE=true
DEMO_PIN=1448

# Claude. Without a key every AI feature falls back to its deterministic path (manual picker, retrieval-only Ask,
# Tesseract drafts for manuscripts). With a key: photo recognition, composed answers, inscription reading,
# manuscript line drafts and "explain this line" glosses (always labelled as AI drafts).
ANTHROPIC_API_KEY=
# Only needed when the key is not scoped to a workspace (the API says "must include the anthropic-workspace-id header").
# Find it in the Claude Console → Settings → Workspaces (starts with wrkspc_).
ANTHROPIC_WORKSPACE_ID=
# Optional per-agent model overrides (default claude-opus-5-5)
AI_MODEL_VISION=
AI_MODEL_ROUTER=
AI_MODEL_COMPOSER=
AI_MODEL_VERIFIER=
AI_MODEL_DRAFT=

# Public URL used in QR labels and share links (e.g. https://signs.example.org)
PUBLIC_BASE_URL=
NEXT_PUBLIC_SITE_URL=

# Set to 1 to ship without the service worker (kill switch, see src/features/pwa/README.md)
NEXT_PUBLIC_PWA_DISABLED=
# Local http testing of a production build only
INSECURE_COOKIES=
