+        assert round(t[k]["exposure_change_pct"]) == -74, k
+    assert t["above_reference"]["blocks"] == 106
+    assert t["above_reference"]["area_ha"] / t["every_block"]["area_ha"] < 0.2
+    assert -32 < t["random_third"]["exposure_change_pct"] < -18
+    assert out["heat_risk"]["targeted_plan"]["residents_cooled_above_reference"] == pytest.approx(10487, abs=2)
+
+
+def test_reference_sensitivity_is_reported(out):
+    rows = out["heat_risk"]["reference_sensitivity"]
+    assert len(rows) == 3
+    plan = [r["targeted_plan_pct"] for r in rows]
+    assert min(plan) > -90 and max(plan) < -60  # the plan holds across the urban quartiles
+    cooling = out["heat_risk"]["resident_weighted_cooling_c"]
+    assert cooling["cool_roofs"] < cooling["pocket_parks"] < 0  # roofs cool the most people
+
+
+def test_new_build_gap_is_mostly_sand(out):
+    gap = out["growth"]["new_build_gap"]
+    assert gap["raw_gap_c"] == pytest.approx(0.95, abs=0.05)
+    assert gap["controlled_gap_c"] < 0.4
