+                         "exposure_change_pct": float(np.median(pct)),
+                         "exposure_change_pct_p5": float(np.percentile(pct, 5)),
+                         "exposure_change_pct_p95": float(np.percentile(pct, 95))},
+        "most_populated_third": cut(pd.Series(d.index.isin(pop.nlargest(n).index), index=d.index)),
     }
