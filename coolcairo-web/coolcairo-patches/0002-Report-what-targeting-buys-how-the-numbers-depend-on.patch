+    rows = []
+    for line in lines:
+        s = exposure_reduction_summary(cfg, result, measured, line)
+        rows.append({"reference_c": line, **{k: float(s[k]) for k in s.index if k.endswith("_pct")},
+                     "targeted_plan_pct": targeted_plan(cfg, result, display, line)["exposure_change_pct"]})
+    return pd.DataFrame(rows).set_index("reference_c")
+
+
+def resident_weighted_cooling(cfg: Config, result: FitResult, display: pd.DataFrame) -> pd.Series:
+    """Average surface change per resident (°C), each measure at full adoption everywhere. Needs no
