+def controlled_new_build_gap(blocks: pd.DataFrame, built_last: str = "built_2023") -> dict:
+    """Surface temperature gap between newly built and established blocks (classes 3 vs 1-2), raw
+    and after allowing for building cover, sand and vegetation (linear regression). New blocks are
+    sandier and less built up, which explains most of the raw gap."""
+    from sklearn.linear_model import LinearRegression
+
+    b = blocks.dropna(subset=["lst_c"])
+    b = b[b.growth_class.isin([1, 2, 3])]
+    new = (b.growth_class == 3).astype(float)
+    raw = float(b.lst_c[new == 1].mean() - b.lst_c[new == 0].mean())
+    x = np.column_stack([new, b[built_last], b.soil_frac, b.veg_frac])
+    controlled = float(LinearRegression().fit(x, b.lst_c).coef_[0])
+    return {"raw_gap_c": raw, "controlled_gap_c": controlled, "blocks": int(len(b))}
