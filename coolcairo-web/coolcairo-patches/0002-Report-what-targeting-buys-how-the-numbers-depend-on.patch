+def roofs_and_parks_delta(cfg: Config, result: FitResult, d: pd.DataFrame) -> pd.Series:
+    """Delta LST per block with cool roofs and pocket parks at full adoption (the plan's measures)."""
+    roofs = cool_roof_delta(cool_roof_surface_deltas(cfg, result), d.dark_roof_frac, d.pale_roof_frac)
+    parks = pocket_park_delta(result, cfg["interventions"]["park_max_share_of_sand"] * d.soil_frac)
+    return roofs + parks
+
+
+def targeting_comparison(
+    cfg: Config, result: FitResult, display: pd.DataFrame, ref: float, draws: int = 500, seed: int = 0
+) -> dict:
+    """How much does choosing the blocks matter? The plan's two measures on every block, on the
+    riskiest third, on only the blocks above the reference, on random thirds and on the most
+    populated third. Exposure only counts degrees above the reference, so blocks below it cannot
+    change it: the gain from targeting is the area saved, which this makes explicit."""
+    d = display.dropna(subset=["lst_c"])
+    pop = d.population.clip(lower=0)
+    delta = roofs_and_parks_delta(cfg, result, d)
+    cap = cfg["interventions"]["park_max_share_of_sand"]
+    area_ha = (d.dark_roof_frac + d.pale_roof_frac + cap * d.soil_frac) * cfg.block_size ** 2 / 1e4
+    base = heat_exposure(d.lst_c, pop, ref).sum()
+
+    def cut(mask: pd.Series) -> dict:
+        after = heat_exposure(d.lst_c + delta.where(mask, 0.0), pop, ref).sum()
+        return {"blocks": int(mask.sum()), "area_ha": float(area_ha[mask].sum()),
+                "exposure_change_pct": float(100 * (after - base) / base)}
+
+    n = len(d) // 3
+    rng = np.random.default_rng(seed)
+    random = []
+    for _ in range(draws):
