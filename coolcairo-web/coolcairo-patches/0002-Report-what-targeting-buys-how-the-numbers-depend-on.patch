+def riskiest_blocks(display: pd.DataFrame, ref: float, share: float = 1 / 3) -> pd.Index:
+    """Valid blocks ranked by baseline heat exposure, ties broken by surface temperature (hottest
+    first); the first `share` of them. The ranking of the targeted plan and the app's tour."""
+    d = display.dropna(subset=["lst_c"])
