{
  "name": "coolcairo-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CoolCairo planner in the browser: block-level urban heat decision support for Nasr City, Cairo.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:artifact": "tsc --noEmit && vite build --mode artifact --outDir dist-artifact",
    "districts": "echo 'uv run --project <CoolCairo>/analysis python scripts/export_districts.py <CoolCairo> src/assets'"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.8.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
